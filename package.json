{
  "name": "secure-zip-notes",
  "version": "2.0.0",
  "private": true,
  "description": "Securely store notes in an AES-256 encrypted Zip file. Offline web app.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48",
  "engines": {
    "node": "22.23.5"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.sw.json",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "node --test \"tests/integration/**/*.test.ts\"",
    "build": "node scripts/build.ts",
    "check:reproducible": "node scripts/check-reproducible.ts",
    "test:e2e": "playwright test",
    "test": "pnpm typecheck && pnpm test:unit && pnpm build && pnpm test:integration && pnpm test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
